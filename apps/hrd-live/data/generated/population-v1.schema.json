{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live-hr.example/schema/population-v1.schema.json",
  "title": "PopulationTransportPayload (raw live-HR exporter asset)",
  "description": "Versioned transport payload emitted by Python. The browser adapter converts this raw shape into the distinct normalized TypeScript PopulationManifest contract.",
  "type": "object",
  "required": ["schemaVersion", "population", "density", "components", "binaries", "mechanisms"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "population": {
      "type": "object",
      "required": ["id", "label", "kind", "formedMassMsun"],
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string"},
        "kind": {"enum": ["composite", "ssp"]},
        "formedMassMsun": {"type": "number", "exclusiveMinimum": 0},
        "fixedAgeGyr": {"type": ["number", "null"]},
        "fixedMetallicityZRel": {"type": ["number", "null"]},
        "starFormationHistory": {"type": "string", "minLength": 1},
        "starFormationHistoryModelId": {"type": "string", "minLength": 1},
        "ageMetallicityRelation": {"type": "string", "minLength": 1},
        "ageMetallicityRelationModelId": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "density": {
      "type": "object",
      "required": ["logTeffEdges", "logLuminosityEdges", "weights", "shape", "order"],
      "properties": {
        "logTeffEdges": {"type": "array", "minItems": 513, "maxItems": 513, "items": {"type": "number"}},
        "logLuminosityEdges": {"type": "array", "minItems": 513, "maxItems": 513, "items": {"type": "number"}},
        "weights": {"type": "array", "minItems": 262144, "maxItems": 262144, "items": {"type": "number", "minimum": 0}},
        "shape": {"const": [512, 512]},
        "order": {"const": "C"},
        "sourceWeightSum": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {"$ref": "#/$defs/component"}
    },
    "mechanisms": {
      "type": "array",
      "items": {"$ref": "#/$defs/mechanism"}
    },
    "binaries": {
      "type": "array",
      "items": {"$ref": "#/$defs/binary"}
    },
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/observation"}
    },
    "observedCatalog": {"$ref": "#/$defs/observedCatalog"},
    "surveySelection": {
      "type": "object",
      "required": [
        "schemaVersion", "passband", "magnitudeSystem", "selectionQuantity",
        "defaultMagnitudeLimit", "minimumMagnitudeLimit", "maximumMagnitudeLimit",
        "sliderStepMagnitude", "densityStepMagnitude", "modelIds",
        "magnitudeDensity", "limitations"
      ],
      "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "passband": {"const": "Gaia_G_EDR3"},
        "magnitudeSystem": {"const": "Vega"},
        "selectionQuantity": {"const": "mean unresolved system apparent magnitude"},
        "defaultMagnitudeLimit": {"type": "number", "minimum": 8, "maximum": 22},
        "minimumMagnitudeLimit": {"const": 8.0},
        "maximumMagnitudeLimit": {"const": 22.0},
        "sliderStepMagnitude": {"const": 0.1},
        "densityStepMagnitude": {"const": 0.1},
        "modelIds": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "magnitudeDensity": {
          "type": "object",
          "required": [
            "schemaVersion", "magnitudeThresholds", "logTeffEdges", "logLuminosityEdges",
            "shape", "encoding", "order", "nonzeroCellCount", "file",
            "transportEncoding", "sha256", "plainSha256", "bytes", "semantics",
            "defaultSelectedSourceWeightSum", "photometricComponentCountWithinMaximumLimit"
          ],
          "properties": {
            "schemaVersion": {"const": "1.0.0"},
            "magnitudeThresholds": {"type": "array", "minItems": 141, "maxItems": 141, "items": {"type": "number"}},
            "logTeffEdges": {"type": "array", "minItems": 513, "maxItems": 513, "items": {"type": "number"}},
            "logLuminosityEdges": {"type": "array", "minItems": 513, "maxItems": 513, "items": {"type": "number"}},
            "shape": {"const": [141, 512, 512]},
            "encoding": {"const": "live-hr-magnitude-density-v1-little-endian"},
            "order": {"const": "magnitude-bin sparse rows; HR cell=x*512+y"},
            "nonzeroCellCount": {"type": "integer", "minimum": 0},
            "file": {"type": "string", "minLength": 1},
            "transportEncoding": {"const": "gzip"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "plainSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 1},
            "semantics": {"type": "string", "minLength": 1},
            "defaultSelectedSourceWeightSum": {"type": "number", "minimum": 0},
            "photometricComponentCountWithinMaximumLimit": {"type": "integer", "minimum": 0},
            "defaultSelectedComponentRealizationWeightSum": {"type": "number", "minimum": 0},
            "photometricComponentRealizationCountWithinMaximumLimit": {"type": "integer", "minimum": 0},
            "prototypeSemantics": {"type": "string", "minLength": 1},
            "baselinePlacementDrawCount": {"type": "integer", "minimum": 1},
            "rareModelPlacementDrawCount": {"type": "integer", "minimum": 1},
            "systemSelectedRealizationWeightByMagnitudeThreshold": {"type": "array", "minItems": 141, "maxItems": 141, "items": {"type": "number", "minimum": 0}},
            "defaultSelectedSystemRealizationWeightSum": {"type": "number", "minimum": 0},
            "completePhotometricSystemPrototypeWeightSum": {"type": "number", "minimum": 0},
            "unavailableSystemPrototypeWeightSum": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "dependentSchemas": {
    "surveySelection": {
      "oneOf": [
        {"required": ["observations"]},
        {"required": ["observedCatalog"]}
      ]
    },
    "observations": {"required": ["surveySelection"]},
    "observedCatalog": {
      "required": ["surveySelection"],
      "properties": {
        "surveySelection": {
          "properties": {
            "magnitudeDensity": {
              "required": [
                "defaultSelectedComponentRealizationWeightSum",
                "photometricComponentRealizationCountWithinMaximumLimit",
                "prototypeSemantics", "baselinePlacementDrawCount",
                "rareModelPlacementDrawCount",
                "systemSelectedRealizationWeightByMagnitudeThreshold",
                "defaultSelectedSystemRealizationWeightSum",
                "completePhotometricSystemPrototypeWeightSum",
                "unavailableSystemPrototypeWeightSum"
              ]
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "observedCatalog": {
      "title": "ObservedCatalogTransportPayload",
      "type": "object",
      "required": ["schemaVersion", "sampling", "components", "binaries", "mechanisms", "observations"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "sampling": {
          "type": "object",
          "required": [
            "modelId", "modelVersion", "referenceKeys", "placementDrawCount",
            "rarePlacementDrawCount", "intrinsicComponentBudget",
            "observedComponentBudget", "rareClassReservePerModel",
            "overlaySemantics", "weightSemantics", "limitations", "assumptionFlags"
          ],
          "properties": {
            "modelId": {"const": "weighted-observed-realization-pps-v1"},
            "modelVersion": {"const": "1.0.0"},
            "referenceKeys": {"const": ["skinner2016"]},
            "placementDrawCount": {"type": "integer", "minimum": 1},
            "rarePlacementDrawCount": {"type": "integer", "minimum": 1},
            "intrinsicComponentBudget": {"type": "integer", "minimum": 0},
            "observedComponentBudget": {"type": "integer", "minimum": 1},
            "rareClassReservePerModel": {"type": "integer", "minimum": 1},
            "overlaySemantics": {"const": "noninferential_visual_exemplars"},
            "weightSemantics": {"type": "string", "minLength": 1},
            "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "assumptionFlags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "components": {"type": "array", "items": {"$ref": "#/$defs/observedComponent"}},
        "binaries": {"type": "array", "items": {"$ref": "#/$defs/observedBinary"}},
        "mechanisms": {"type": "array", "items": {"$ref": "#/$defs/mechanism"}},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/observedObservation"}}
      },
      "additionalProperties": false
    },
    "observedRealization": {
      "type": "object",
      "required": [
        "realizationSystemId", "sourcePrototypeSystemId",
        "sourcePrototypeNumericSystemId", "realizationIndex",
        "placementDrawIndex", "prototypeSourceWeight",
        "realizationMeasureWeight", "visualizationCalibrationWeight",
        "overlayRole", "overlayStratum"
      ],
      "properties": {
        "realizationSystemId": {"type": "integer", "minimum": 0},
        "sourcePrototypeSystemId": {"type": "string", "minLength": 1},
        "sourcePrototypeNumericSystemId": {"type": "integer", "minimum": 0},
        "realizationIndex": {"type": "integer", "minimum": 0},
        "placementDrawIndex": {"type": "integer", "minimum": 0},
        "prototypeSourceWeight": {"type": "number", "exclusiveMinimum": 0},
        "realizationMeasureWeight": {"type": "number", "exclusiveMinimum": 0},
        "visualizationCalibrationWeight": {"type": "number", "exclusiveMinimum": 0},
        "overlayRole": {"enum": ["weighted_draw", "rare_model_reserve"]},
        "overlayStratum": {"type": "string", "minLength": 1}
      }
    },
    "observedComponent": {
      "allOf": [
        {"$ref": "#/$defs/component"},
        {"$ref": "#/$defs/observedRealization"},
        {
          "type": "object",
          "required": ["sourcePrototypeComponentId", "weightSemantics"],
          "properties": {
            "sourcePrototypeComponentId": {"type": "string", "minLength": 1},
            "weightSemantics": {"const": "noninferential_visualization_calibration"}
          }
        }
      ]
    },
    "observedBinary": {
      "allOf": [
        {"$ref": "#/$defs/binary"},
        {"$ref": "#/$defs/observedRealization"},
        {
          "type": "object",
          "required": ["sourcePrototypeBinaryId"],
          "properties": {
            "sourcePrototypeBinaryId": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "observedObservation": {
      "allOf": [
        {"$ref": "#/$defs/observation"},
        {"$ref": "#/$defs/observedRealization"}
      ]
    },
    "mechanism": {
      "title": "MechanismTransportRecord",
      "oneOf": [
        {"$ref": "#/$defs/cepheidMechanism"},
        {"$ref": "#/$defs/rrLyraeMechanism"},
        {"$ref": "#/$defs/deltaScutiMechanism"},
        {"$ref": "#/$defs/gammaDorMechanism"},
        {"$ref": "#/$defs/spbMechanism"},
        {"$ref": "#/$defs/betaCepheiMechanism"},
        {"$ref": "#/$defs/solarLikeMechanism"},
        {"$ref": "#/$defs/redGiantMechanism"},
        {"$ref": "#/$defs/miraMechanism"},
        {"$ref": "#/$defs/semiregularMechanism"},
        {"$ref": "#/$defs/davMechanism"},
        {"$ref": "#/$defs/dbvMechanism"},
        {"$ref": "#/$defs/gwVirMechanism"},
        {"$ref": "#/$defs/activityMechanism"},
        {"$ref": "#/$defs/hotStarSlfMechanism"},
        {"$ref": "#/$defs/microvariabilityMechanism"}
      ]
    },
    "mechanismEnvelope": {
      "type": "object",
      "required": ["id", "componentId", "kind", "modelId", "modelVersion", "referenceKeys", "confidence", "assumptionFlags", "parameters"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "componentId": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "modelId": {"type": "string", "minLength": 1},
        "modelVersion": {"type": "string", "minLength": 1},
        "referenceKeys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "confidence": {"enum": ["high", "medium", "low", "very-low"]},
        "assumptionFlags": {"type": "array", "items": {"type": "string"}},
        "parameters": {"type": "object"},
        "citations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "cepheidMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "cepheid"},
          "modelId": {"const": "cepheid-radial-v1"},
          "modelVersion": {"const": "1.1.0"},
          "referenceKeys": {"const": ["anderson2016", "desomma2022", "smolec2026", "pejcha2012"]},
          "confidence": {"const": "medium"},
          "parameters": {"$ref": "#/$defs/cepheidRadialParameters"}
        }}
      ]
    },
    "rrLyraeMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "rr_lyrae"},
          "modelId": {"const": "rr-lyrae-radial-v1"},
          "modelVersion": {"const": "1.1.0"},
          "referenceKeys": {"const": ["marconi2015", "desomma2024", "medina2026"]},
          "confidence": {"const": "medium"},
          "parameters": {"$ref": "#/$defs/rrLyraeRadialParameters"}
        }}
      ]
    },
    "deltaScutiMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "delta_scuti"},
          "modelId": {"const": "delta-scuti-multimode-v1"},
          "modelVersion": {"const": "1.0.0"},
          "referenceKeys": {"const": ["murphy2022", "aerts2010"]},
          "confidence": {"const": "low"},
          "parameters": {"$ref": "#/$defs/deltaMultimodeParameters"}
        }}
      ]
    },
    "gammaDorMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "gamma_dor"},
          "modelId": {"const": "gamma-dor-multimode-v1"},
          "modelVersion": {"const": "1.0.0"},
          "referenceKeys": {"const": ["aerts2010"]},
          "confidence": {"const": "low"},
          "parameters": {"$ref": "#/$defs/deterministicMultimodeParameters"}
        }}
      ]
    },
    "spbMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "spb"},
          "modelId": {"const": "spb-multimode-v1"},
          "modelVersion": {"const": "1.0.0"},
          "referenceKeys": {"const": ["aerts2010"]},
          "confidence": {"const": "low"},
          "parameters": {"$ref": "#/$defs/deterministicMultimodeParameters"}
        }}
      ]
    },
    "betaCepheiMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "beta_cephei"},
          "modelId": {"const": "beta-cephei-multimode-v1"},
          "modelVersion": {"const": "1.0.0"},
          "referenceKeys": {"const": ["aerts2010"]},
          "confidence": {"const": "low"},
          "parameters": {"$ref": "#/$defs/deterministicMultimodeParameters"}
        }}
      ]
    },
    "solarLikeMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "solar_like"},
          "modelId": {"const": "solar-like-stochastic-v1"},
          "modelVersion": {"const": "1.1.0"},
          "referenceKeys": {"const": ["chaplin2011", "kallinger2014"]},
          "confidence": {"const": "medium"},
          "parameters": {"$ref": "#/$defs/asteroseismicParameters"}
        }}
      ]
    },
    "redGiantMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "red_giant"},
          "modelId": {"const": "red-giant-stochastic-v1"},
          "modelVersion": {"const": "1.1.0"},
          "referenceKeys": {"const": ["chaplin2011", "kallinger2014"]},
          "confidence": {"const": "medium"},
          "parameters": {"$ref": "#/$defs/asteroseismicParameters"}
        }}
      ]
    },
    "miraMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "mira"},
          "modelId": {"const": "mira-radial-v1"},
          "modelVersion": {"const": "1.0.0"},
          "referenceKeys": {"const": ["wood2000", "aerts2010"]},
          "confidence": {"const": "low"},
          "parameters": {"$ref": "#/$defs/miraRadialParameters"}
        }}
      ]
    },
    "semiregularMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "semiregular"},
          "modelId": {"const": "semiregular-multimode-v1"},
          "modelVersion": {"const": "1.0.0"},
          "referenceKeys": {"const": ["wood2000", "aerts2010"]},
          "confidence": {"const": "low"},
          "parameters": {"$ref": "#/$defs/stochasticMultimodeParameters"}
        }}
      ]
    },
    "davMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "dav"},
          "modelId": {"const": "dav-white-dwarf-v1"},
          "modelVersion": {"const": "1.1.0"},
          "referenceKeys": {"const": ["corsico2020"]},
          "confidence": {"const": "medium"},
          "parameters": {"$ref": "#/$defs/deterministicMultimodeParameters"}
        }}
      ]
    },
    "dbvMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "dbv"},
          "modelId": {"const": "dbv-white-dwarf-v1"},
          "modelVersion": {"const": "1.1.0"},
          "referenceKeys": {"const": ["corsico2020"]},
          "confidence": {"const": "medium"},
          "parameters": {"$ref": "#/$defs/deterministicMultimodeParameters"}
        }}
      ]
    },
    "gwVirMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "gw_vir"},
          "modelId": {"const": "gwvir-white-dwarf-v1"},
          "modelVersion": {"const": "1.1.0"},
          "referenceKeys": {"const": ["corsico2020"]},
          "confidence": {"const": "low"},
          "parameters": {"$ref": "#/$defs/deterministicMultimodeParameters"}
        }}
      ]
    },
    "activityMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "activity"},
          "modelId": {"const": "cool-star-activity-v1"},
          "modelVersion": {"const": "1.0.0"},
          "referenceKeys": {"const": ["mamajek2008", "pecaut2013", "wright2011", "vansaders2016", "mcquillan2014", "herbst2021", "giles2017", "reinhold2015", "davenport2014", "davenport2016", "namekata2017"]},
          "confidence": {"const": "low"},
          "parameters": {"$ref": "#/$defs/activityParameters"}
        }}
      ]
    },
    "hotStarSlfMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "hot_slf"},
          "modelId": {"const": "hot-star-slf-v1"},
          "modelVersion": {"const": "1.0.0"},
          "referenceKeys": {"const": ["bowman2025"]},
          "confidence": {"const": "low"},
          "parameters": {"$ref": "#/$defs/stochasticMultimodeParameters"}
        }}
      ]
    },
    "microvariabilityMechanism": {
      "allOf": [
        {"$ref": "#/$defs/mechanismEnvelope"},
        {"properties": {
          "kind": {"const": "microvariability"},
          "modelId": {"const": "microvariability-floor-v1"},
          "modelVersion": {"const": "1.0.0"},
          "referenceKeys": {"const": ["aerts2010"]},
          "confidence": {"const": "very-low"},
          "parameters": {"$ref": "#/$defs/deterministicMultimodeParameters"}
        }}
      ]
    },
    "seed32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "radialParameters": {
      "type": "object",
      "required": [
        "seed", "periodD", "phaseRad", "radiusFundamentalFraction",
        "temperatureFundamentalFraction", "temperatureLagRad", "radiusHarmonics",
        "temperatureHarmonics", "radiusHarmonicPhasesRad",
        "temperatureHarmonicPhasesRad", "luminosityMeanNormalization",
        "amplitudeDefinition"
      ],
      "properties": {
        "seed": {"$ref": "#/$defs/seed32"},
        "periodD": {"type": "number", "exclusiveMinimum": 0},
        "phaseRad": {"type": "number"},
        "radiusFundamentalFraction": {"type": "number", "minimum": 0},
        "temperatureFundamentalFraction": {"type": "number", "minimum": 0},
        "temperatureLagRad": {"type": "number"},
        "radiusHarmonics": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "temperatureHarmonics": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "radiusHarmonicPhasesRad": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "temperatureHarmonicPhasesRad": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "luminosityMeanNormalization": {"type": "number", "exclusiveMinimum": 0},
        "amplitudeDefinition": {"const": "fractional semi-amplitude of the fundamental"},
        "pulsationMode": {"enum": ["F", "1O", "RRab", "RRc"]},
        "stripAmplitudeTaper": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "cepheidRadialParameters": {
      "allOf": [
        {"$ref": "#/$defs/radialParameters"},
        {"required": ["pulsationMode", "stripAmplitudeTaper"], "properties": {"pulsationMode": {"enum": ["F", "1O"]}}}
      ]
    },
    "rrLyraeRadialParameters": {
      "allOf": [
        {"$ref": "#/$defs/radialParameters"},
        {"required": ["pulsationMode", "stripAmplitudeTaper"], "properties": {"pulsationMode": {"enum": ["RRab", "RRc"]}}}
      ]
    },
    "miraRadialParameters": {
      "allOf": [
        {"$ref": "#/$defs/radialParameters"},
        {"not": {"anyOf": [{"required": ["pulsationMode"]}, {"required": ["stripAmplitudeTaper"]}]}}
      ]
    },
    "multimodeParameters": {
      "type": "object",
      "required": ["seed", "periodsD", "luminositySemiAmplitudes", "phasesRad", "temperatureToLuminosityFraction", "amplitudeDefinition"],
      "properties": {
        "seed": {"$ref": "#/$defs/seed32"},
        "periodsD": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
        "luminositySemiAmplitudes": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "phasesRad": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "temperatureToLuminosityFraction": {"type": "number", "minimum": 0, "maximum": 1},
        "amplitudeDefinition": {"const": "fractional luminosity semi-amplitude"},
        "subclass": {"enum": ["delta_scuti", "sx_phe"]},
        "modeLifetimesD": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
        "stochasticPhaseRenewal": {"const": true},
        "numaxMicroHz": {"type": "number", "exclusiveMinimum": 0},
        "oscillationAmplitudePpm": {"type": "number", "exclusiveMinimum": 0},
        "granulationTimescalesD": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
        "granulationRmsFractions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}},
        "granulationSeed": {"$ref": "#/$defs/seed32"}
      },
      "additionalProperties": false
    },
    "deterministicMultimodeParameters": {
      "allOf": [
        {"$ref": "#/$defs/multimodeParameters"},
        {"not": {"anyOf": [
          {"required": ["subclass"]}, {"required": ["modeLifetimesD"]},
          {"required": ["stochasticPhaseRenewal"]}, {"required": ["numaxMicroHz"]},
